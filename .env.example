# Backend - MT5
CUSTOM_USER=admin
PASSWORD=1234
VNC_DOMAIN=vnc.mt5.example.com
API_DOMAIN=api.mt5.example.com
MT5_API_PORT=5001

# Traefik
TRAEFIK_DOMAIN=traefik.mt5.example.com
TRAEFIK_USERNAME=admin
ACME_EMAIL=admin@example.com

# Postgres
POSTGRES_DB=postgres
POSTGRES_USER=admin
POSTGRES_PASSWORD=1234

# Monitoring
GRAFANA_DOMAIN=grafana.mt5.example.com

# Backend - Django
MT5_API_URL=http://mt5:5001
DJANGO_DOMAIN=django.mt5.example.com

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Raspberry Pi NPU inference offload (optional — falls back to local processing)
# Set false if you have no Pi; otherwise it retries into a circuit breaker on
# every call. If enabled, point the URL at the Pi's LAN IP.
PI_NPU_ENABLED=false
PI_NPU_URL=http://192.168.1.50:8100

# Polymarket wallet
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=          # wallet address that holds USDC (NOT the private key)
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_CHAIN_ID=137
POLYMARKET_SIGNATURE_TYPE=0         # 0=EOA, 1=Magic, 2=GnosisSafe

# Polymarket trading parameters
POLYMARKET_KELLY_FRACTION=0.15
POLYMARKET_EV_THRESHOLD=0.05
POLYMARKET_MAX_POSITIONS=5
POLYMARKET_CAPITAL_USD=500

# Claude API for LLM probability estimation
ANTHROPIC_API_KEY=
POLYMARKET_LLM_MODEL=claude-sonnet-4-6-20250627
POLYMARKET_LLM_MAX_MARKETS=50

# AI Brain — autonomous quant analyst (toggle on/off from dashboard)
AI_BRAIN_MODEL=claude-opus-4-6-20250725
AI_BRAIN_MAX_TOKENS=4096

# Hyperliquid crypto trading bot
HYPERLIQUID_PRIVATE_KEY=            # master key (only needed to create agent wallets)
HYPERLIQUID_WALLET_ADDRESS=         # your wallet address for position lookups
HYPERLIQUID_AGENT_KEY=              # trade-only delegate key (preferred for bot, cannot withdraw)
HYPERLIQUID_TESTNET=true

# Crypto trading parameters
CRYPTO_PAIRS=BTC,ETH,SOL,ARB
CRYPTO_CAPITAL_USD=1000
CRYPTO_MAX_POSITIONS=3
CRYPTO_LEVERAGE=1
CRYPTO_STRATEGY=momentum
CRYPTO_FAST_MA=50
CRYPTO_SLOW_MA=200
CRYPTO_LOOKBACK=252
CRYPTO_MAX_POSITION_PCT=0.10
CRYPTO_STOP_LOSS_PCT=0.05
CRYPTO_TAKE_PROFIT_PCT=0.10

# Lighter.xyz DEX trading bot (zk-powered orderbook)
LIGHTER_API_URL=https://mainnet.zklighter.elliot.ai  # testnet: leave default; mainnet: https://mainnet.zklighter.elliot.ai
LIGHTER_PRIVATE_KEY=                # private key for signing transactions (from Generate API Key)
LIGHTER_PUBLIC_KEY=                 # public key (for verification, from Generate API Key)
LIGHTER_API_KEY_INDEX=3             # API key index (3-254, 0-2 reserved for official apps)
LIGHTER_ACCOUNT_INDEX=              # your account index (query AccountApi if unknown)
LIGHTER_TESTNET=true