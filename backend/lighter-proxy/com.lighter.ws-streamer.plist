<!-- Lighter.xyz WebSocket Streamer — persistent macOS service via launchd.
     Install:
       cp com.lighter.ws-streamer.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.lighter.ws-streamer.plist
     Uninstall:
       launchctl unload ~/Library/LaunchAgents/com.lighter.ws-streamer.plist && rm ~/Library/LaunchAgents/com.lighter.ws-streamer.plist
-->
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lighter.ws-streamer</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Library/Developer/CommandLineTools/Library/Frameworks/Python3.framework/Versions/3.9/Resources/Python.app/Contents/MacOS/Python</string>
        <string>ws_streamer.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/rosaria/Desktop/metatrader5-quant-server-python/backend/lighter-proxy</string>

    <key>KeepAlive</key>
    <true/>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/lighter-ws-streamer-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/lighter-ws-streamer-stderr.log</string>
</dict>
</plist>
